<!DOCTYPE html>
<html lang="zh-TW" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>在地景點總覽 - 探探里山</title>
    
    <!-- 引入字體與 Tailwind CSS -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: { 
                extend: { 
                    colors: { 
                        mori: { base: '#F7F4EF', light: '#E8EFE6', sage: '#8B9D77', forest: '#4A6741', wood: '#D2B48C', dark: '#2C3E28' } 
                    }, 
                    fontFamily: { sans: ['Noto Sans TC', 'sans-serif'] } 
                } 
            }
        }
    </script>
    <style>
        body { background-color: #F9FAFB; color: #2C3E28; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; }
    </style>
</head>
<body class="font-sans antialiased overflow-x-hidden pb-20">

    <!-- 頂部導航列 -->
    <header class="bg-mori-forest text-white sticky top-0 z-50 shadow-md">
        <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a href="main_interactive.html" class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors">
                    <i class="fas fa-arrow-left text-white"></i>
                </a>
                <h1 class="text-xl font-bold tracking-wide">在地景點與合作夥伴</h1>
            </div>
            <div class="text-xs bg-white/20 px-3 py-1.5 rounded-full font-medium tracking-widest shadow-inner">
                <i class="fas fa-leaf mr-1"></i>探探里山
            </div>
        </div>
    </header>

    <!-- 主視覺 Banner -->
    <div class="w-full bg-mori-base border-b border-mori-sage/20 py-8 px-4 text-center">
        <div class="max-w-2xl mx-auto">
            <div class="w-16 h-16 bg-mori-light rounded-full flex items-center justify-center mx-auto mb-3 shadow-sm border-2 border-mori-sage">
                <i class="fas fa-map-marked-alt text-2xl text-mori-forest"></i>
            </div>
            <h2 class="text-2xl font-black text-mori-dark mb-2 tracking-wide">探索永續農村之美</h2>
            <p class="text-sm text-gray-600 leading-relaxed">
                這裡是探探里山的優質合作夥伴清單。<br>
                您可以瀏覽各類別景點，並點擊「在地圖中查看」返回主頁規劃您的減碳路線！
            </p>
        </div>
    </div>

    <!-- 景點列表容器 -->
    <main class="max-w-5xl mx-auto px-4 py-8">
        <div id="directory-container" class="space-y-10">
            <!-- 骨架屏 (資料載入中) -->
            <div class="animate-pulse space-y-4">
                <div class="h-8 bg-gray-200 rounded w-1/4 mb-4"></div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="h-24 bg-gray-200 rounded-xl"></div>
                    <div class="h-24 bg-gray-200 rounded-xl"></div>
                </div>
            </div>
        </div>
    </main>

    <script>
        // ==========================================
        // 1. 靜態景點資料庫 (排除第 6 類的動態活動)
        // ==========================================
        const poiCategories = [
            { id: 4, title: '水里里山基地', desc: '基地推行里山倡議，串聯商圈與青農之永續據點。', icon: 'fa-campground', color: 'text-emerald-700', bg: 'bg-emerald-50', border: 'border-emerald-200' }, 
            { id: 1, title: '里山餐桌團隊', desc: '核心規劃團隊，提供生態旅遊與 ESG 專案規劃。', icon: 'fa-users', color: 'text-blue-700', bg: 'bg-blue-50', border: 'border-blue-200' }, 
            { id: 5, title: '南投青農', desc: '結合優質青農，提供高品質特色食農體驗。', icon: 'fa-tractor', color: 'text-amber-700', bg: 'bg-amber-50', border: 'border-amber-200' }, 
            { id: 3, title: '水里觀光商圈', desc: '提供在地特色美食與優質採購，支持商圈創生。', icon: 'fa-store', color: 'text-orange-700', bg: 'bg-orange-50', border: 'border-orange-200' }, 
            { id: 2, title: '低碳食宿', desc: '精選本地觀光食宿，倡議節水節電與永續觀光。', icon: 'fa-bed', color: 'text-purple-700', bg: 'bg-purple-50', border: 'border-purple-200' }
        ];
        
        // 這些資料未來可以獨立成一個 pois_data.js 讓主頁和此頁共用
        const pois = [
            {categoryId:4, id:'poi1', name:'水里溪畔驛站', icon:'🌲', esgEligible:true, fbUrl:'https://www.facebook.com/profile.php?id=100076220760859'},
            {categoryId:4, id:'poi25', name:'台大林管處水里營林區', icon:'🏛️', fbUrl:'https://www.facebook.com/xitou.nature.education'},
            {categoryId:1, id:'poi12', name:'湧健酪梨園/梅園', isSroi:true, icon:'🥑', esgEligible:true, fbUrl:'https://www.facebook.com/profile.php?id=100085673588742'},
            {categoryId:1, id:'poi11', name:'阿爾喜莊園', isSroi:true, icon:'🍋', esgEligible:true, fbUrl:'https://www.facebook.com/AHEIemon'},
            {categoryId:1, id:'poi10', name:'雨社山下', isSroi:true, icon:'🥒', esgEligible:true, fbUrl:'https://www.facebook.com/YusheLand'},
            {categoryId:1, id:'poi8', name:'明揚養蜂', isSroi:true, icon:'🐝', esgEligible:true, fbUrl:'https://www.facebook.com/MingYangBee'},
            {categoryId:1, id:'poi7', name:'指令教育農場', isSroi:true, icon:'👆', esgEligible:true, fbUrl:'https://www.facebook.com/FarmCMD'},
            {categoryId:1, id:'poi19', name:'小茶米農場', isSroi:true, icon:'🍵', esgEligible:true},
            {categoryId:1, id:'poi3', name:'鑫鮮菇園', icon:'🍄', esgEligible:true},
            {categoryId:1, id:'poi26', name:'饕農園', icon:'🧑‍🌾', esgEligible:true},
            {categoryId:1, id:'poi27', name:'Hó-lah! 星澍柢家', icon:'🌱', esgEligible:true},
            {categoryId:5, id:'poi30', name:'墨梵農場香草莊園', icon:'🪴'},
            {categoryId:5, id:'poi20', name:'集元果觀光工廠', icon:'🍌'},
            {categoryId:5, id:'poi21', name:'山水裡愛玉園', icon:'🌿'},
            {categoryId:5, id:'poi28', name:'新豐農場(冷泉米)', icon:'🌾'},
            {categoryId:5, id:'poi29', name:'逸和園檸檬宿', icon:'🍋'},
            {categoryId:3, id:'poi_new1', name:'水里槑休閒農業區', icon:'🛖'},
            {categoryId:2, id:'poi16', name:'水里里山村(低碳旅店)', icon:'🏡', esgEligible:true},
            {categoryId:2, id:'poi14', name:'機車貓聯盟(食店)', icon:'🍚'},
            {categoryId:3, id:'poi23', name:'車程林班道', icon:'🚂'},
            {categoryId:3, id:'poi24', name:'車埕木業展示館', icon:'🪵'},
            {categoryId:3, id:'poi18', name:'森音 Morinooto', icon:'🎶'},
            {categoryId:3, id:'poi9', name:'蛇窯文化園區', icon:'🏺'},
            {categoryId:3, id:'poi17', name:'水里星光市集', icon:'💡'}
        ];

        // ==========================================
        // 2. 渲染邏輯
        // ==========================================
        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('directory-container');
            let html = '';

            poiCategories.forEach(cat => {
                const catPois = pois.filter(p => p.categoryId === cat.id);
                
                if (catPois.length > 0) {
                    html += `
                    <section class="animate-fade-in-down">
                        <!-- 類別標題 -->
                        <div class="${cat.bg} border border-${cat.border} rounded-2xl p-4 mb-4 shadow-sm flex items-start gap-4">
                            <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center shrink-0 shadow-inner border border-gray-100">
                                <i class="fas ${cat.icon} text-xl ${cat.color}"></i>
                            </div>
                            <div>
                                <h3 class="text-lg font-black ${cat.color} tracking-wide">${cat.title}</h3>
                                <p class="text-xs text-gray-600 mt-1 leading-relaxed">${cat.desc}</p>
                            </div>
                        </div>

                        <!-- 景點卡片網格 -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 pl-2 md:pl-4 border-l-2 border-gray-200 ml-4 md:ml-6 py-2">
                            ${catPois.map(poi => {
                                
                                // 判斷是否顯示 SROI 標籤
                                const sroiBadge = poi.isSroi ? `<span class="bg-green-100 text-green-700 px-1.5 py-0.5 rounded text-[10px] font-bold shadow-sm ml-2 shrink-0 border border-green-200">SROI ✓</span>` : '';
                                
                                // 判斷是否顯示 ESG 憑證標籤
                                const esgBadge = poi.esgEligible ? `<span class="bg-blue-50 text-blue-600 px-1.5 py-0.5 rounded text-[10px] font-bold shadow-sm ml-1 shrink-0 border border-blue-100" title="可進行綠色消費登錄"><i class="fas fa-leaf mr-0.5"></i>ESG</span>` : '';

                                return `
                                <div class="bg-white p-3.5 rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-mori-sage transition-all duration-300 group flex flex-col justify-between h-full relative overflow-hidden">
                                    <div class="absolute right-0 top-0 w-8 h-8 bg-gray-50 rounded-bl-3xl flex items-start justify-end p-1.5 group-hover:bg-mori-light transition-colors">
                                        <i class="fas fa-map-marker-alt text-gray-300 group-hover:text-mori-sage text-[10px]"></i>
                                    </div>
                                    <div>
                                        <div class="flex items-center mb-2 pr-4">
                                            <span class="text-2xl mr-2.5 filter drop-shadow-sm group-hover:scale-110 transition-transform">${poi.icon}</span>
                                            <div class="flex flex-wrap items-center gap-y-1">
                                                <h4 class="text-[14px] font-bold text-gray-800 leading-tight">${poi.name}</h4>
                                                <div class="flex">${sroiBadge}${esgBadge}</div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="flex gap-2 mt-3 pt-3 border-t border-gray-50">
                                        <button onclick="window.locateOnMap('${poi.id}')" class="flex-1 py-2 bg-mori-forest/10 hover:bg-mori-forest text-mori-forest hover:text-white rounded-lg text-xs font-bold transition-colors border border-mori-forest/20 flex items-center justify-center group/btn">
                                            <i class="fas fa-location-arrow mr-1.5 group-hover/btn:animate-bounce"></i>在地圖中查看
                                        </button>
                                        ${poi.fbUrl ? `<a href="${poi.fbUrl}" target="_blank" class="px-3 py-2 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg text-xs font-bold transition-colors border border-blue-200 flex items-center justify-center"><i class="fab fa-facebook-f"></i></a>` : ''}
                                    </div>
                                </div>
                                `;
                            }).join('')}
                        </div>
                    </section>
                    `;
                }
            });

            container.innerHTML = html;
        });

        // 點擊「在地圖中查看」時，跳轉回主站並帶上景點參數
        window.locateOnMap = function(poiId) {
            // 跳轉邏輯：回到主頁並把 poi 參數放在網址上
            // 您未來在 main_interactive.html 中只需讀取網址的 ?locatePoi=xxx 即可自動展開側邊欄
            window.location.href = `main_interactive.html?locatePoi=${poiId}`;
        };
    </script>
</body>
</html>
